# Copy to .env and adjust. Every value here has a working default for local
# development except the admin account, which is only created when both are set.

# --- App ---
# development | production | test
APP_ENV=development
DEBUG=false
# In production the API refuses to start with the default key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./aarogya.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
RATE_LIMIT=60/minute

# Optional admin account (seeded on startup if both are set)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- LLM (Ollama) ---
# From Docker, use http://host.docker.internal:11434 to reach Ollama on the host.
OLLAMA_BASE_URL=http://localhost:11434
# or qwen2.5:7b
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_NUM_CTX=4096
# seconds
LLM_CONNECT_TIMEOUT=5
# seconds without a new token before giving up
LLM_READ_TIMEOUT=120
# seconds to cache the Ollama health check
LLM_HEALTH_TTL=30

# --- Retrieval ---
# Relative paths are resolved from the project root.
# created by scripts/prepare_medquad.py
DATASET_PATH=dataset/medquad.json
# tfidf (no downloads) | faiss (needs requirements-embeddings.txt)
RETRIEVER=tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_DIR=vector_db
# characters; 0 = one chunk per answer
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=4
# The bot declines when the best passage scores below this (cosine similarity).
MIN_RELEVANCE_TFIDF=0.15
MIN_RELEVANCE_FAISS=0.45
